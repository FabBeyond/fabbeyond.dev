---
interface Link {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  links: Link[];
  image: string;
  tags: string[];
  isWIP: boolean;
  type: string;
  downloads: string;
}

const { title, description, links, image, tags, isWIP, type, downloads } =
  Astro.props;
---

<div class={type}>
  <div class="project-content">
    <div class="top-row">
      {image.endsWith(".mp4") ? (
        <video
          src={image}
          autoplay
          loop
          muted
          playsinline
          class="project-image"
        />
      ) : (
        image && <img src={image} alt={title} class="project-image" />
      )}
      <div class="project-title-container">
        <p class="project-title">{title}</p>
        {isWIP && <div class="wip-project-tag">WIP</div>}
      </div>
    </div>
    <p class="project-description">{description}</p>
    <div class="project-tags">
      {tags.map((i) => (
        <div class="project-tag">{i}</div>
      ))}
    </div>
    {downloads != null && <p class="downloads">{downloads}</p>}
    <div class="fill"></div>
    <div class="project-links">
      {links.map((i) => (
        <div class="project-link">
          <a href={i.href} target="_blank">
            {i.label}
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </a>
        </div>
      ))}
    </div>
  </div>
</div>
