---
import "../styles/style.css";
import Navbar from "../components/Navbar.astro";
import FeaturedProjectCard from "../components/FeaturedProjectCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
const projects = [
  {
    title: "LITT",
    description:
      "LITT is a CLI tool to display lyrics of the currently playing song in the terminal",
    links: [{ href: "https://github.com/FabBeyond/litt", label: "GitHub" }],
    image: "",
    tags: ["Python", "CLI", "PyPi"],
    isWIP: false,
  },
  {
    title: "TailFE",
    description:
      "TailFE is a fully customaizable, cross platform file explorer",
    links: [{ href: "https://github.com/FabBeyond/TailFE", label: "GitHub" }],
    image: "",
    tags: ["React", "Javascript", "Electron"],
    isWIP: true,
  },
  {
    title: "Fortuna",
    description:
      "Fortuna is a rogue-like card game made for the 2025 Spengergasse internal game jam",
    links: [{ href: "https://fabbeyond.itch.io/fortuna", label: "itch.io" }],
    image: "/GameIcons/Fortuna.png",
    tags: ["Unity", "C#"],
    isWIP: false,
  },
  {
    title: "Layout Tools",
    description: "Simple tools to make building layouts easier",
    links: [{ href: "", label: "Geode" }],
    tags: ["Geometry Dash", "C++", "Modding"],
    isWIP: false,
  },
  {
    title: "StartPos En/Disabler",
    description: "Enable/Disable multiple start positions with one click",
    links: [
      {
        href: "https://geode-sdk.org/mods/fabbeyond.startposdisabler",
        label: "Geode",
      },
    ],
    tags: ["Geometry Dash", "C++", "Modding"],
    isWIP: false,
  },
  {
    title: "Random Teleport",
    description: "Teleports you somewhere completly random every 3 minutes.",
    links: [{ href: "", label: "Thunderstore" }],
    tags: ["Silksong", "C#", "BepInEx"],
    isWIP: false,
  },
  {
    title: "Hornet Addict",
    description:
      "Takes Hornets needle away and gives her only Flea Brew bottles to throw",
    links: [{ href: "", label: "Thunderstore" }],
    tags: ["Silksong", "C#", "BepInEx"],
    isWIP: false,
  },
  {
    title: "Infinite Cogflies",
    description: "Mod to remove the Cogfly amount cap",
    links: [{ href: "", label: "Thunderstore" }],
    tags: ["Silksong", "C#", "BepInEx"],
    isWIP: false,
  },
  {
    title: "Zaza in Bellhome",
    description:
      "Allows you to bring Zaza to your Bellhome after defeating Lost Garmond",
    links: [{ href: "", label: "Thunderstore" }],
    tags: ["Silksong", "C#", "BepInEx"],
    isWIP: false,
  },
];
const featuredProjects = ["LITT", "TailFE", "Fortuna"];
const mods = [
  "StartPos En/Disabler",
  "Layout Tools",
  "Random Teleport",
  "Hornet Addict",
  "Infinite Cogflies",
  "Zaza in Bellhome",
];
function getProjects(names: string[]) {
  return projects.filter((i) => names.includes(i.title));
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>fabbeyond.dev - Projects</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <Navbar />

    <main>
      <div class="about">
        <p class="personal-title font">Hi, I'm Fab.</p>
        <p class="personal-subtitle font">
          I make games, mods, tools and self-hosted backends.
        </p>
        <p class="location font">
          Student at HTL Spengergasse · Vienna, Austria
        </p>
        <div class="skills-list">
          <p>Python</p>
          <p>C#</p>
          <p>JavaScript</p>
          <p>HTML/CSS</p>
          <p>React</p>
        </div>

        <div class="about-btn">
          <a class="btn-primary font" href="https://github.com/FabBeyond/">
            GitHub
          </a>
          <a class="btn-secondary font" href="mailto:fabian.wurmitzer@gmx.at">
            Email me
          </a>
        </div>
      </div>

      <p class="collection-title">Featured Projects</p>
      <div class="project-list">
        {getProjects(featuredProjects).map((i) => (
          <FeaturedProjectCard {...i} />
        ))}
      </div>

      <p class="collection-title">Mods</p>
      <div class="project-list">
        {getProjects(mods).map((i) => (
          <ProjectCard {...i} />
        ))}
      </div>
    </main>
  </body>
</html>
