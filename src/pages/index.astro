---
import "../styles/style.css";
import Navbar from "../components/Navbar.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import fortunaImg from "../assets/GameIcons/Fortuna.png";
import ohCrabImg from "../assets/GameIcons/OhCrab.png";
import balancedLoadImg from "../assets/GameIcons/BalancedLoad.png";
import layoutToolsImg from "../assets/ModIcons/LayoutTools.png";
import startPosImg from "../assets/ModIcons/StartPosEnDisabler.png";
import randomTeleportImg from "../assets/ModIcons/RandomTeleport.png";
import hornetAddictImg from "../assets/ModIcons/HornetAddict.png";
import infiniteCogfliesImg from "../assets/ModIcons/InfiniteCogflies.png";
import zazaImg from "../assets/ModIcons/ZazaInBellhome.png";
import romaImg from "../assets/ProgramIcons/roma.png";
import cogflyImg from "../assets/ProgramIcons/Cogfly.png";

const projects = [
  {
    title: "LITT",
    description:
      "LITT is a CLI tool to display lyrics of the currently playing song in the terminal",
    links: [{ href: "https://github.com/FabBeyond/litt", label: "GitHub" }],
    video: {
      src: "/ProgramIcons/litt.mp4",
      poster: "/ProgramIcons/litt-poster.webp",
    },
    tags: ["Python", "CLI", "PyPi"],
    isWIP: false,
  },
  {
    title: "TailFE",
    description: "TailFE is a fully customizable, cross platform file explorer",
    links: [{ href: "https://github.com/FabBeyond/TailFE", label: "GitHub" }],
    video: {
      src: "/ProgramIcons/tailfe.mp4",
      poster: "/ProgramIcons/tailfe-poster.webp",
    },
    tags: ["React", "Javascript", "Electron"],
    isWIP: true,
  },
  {
    title: "Fortuna",
    description:
      "Fortuna is a rogue-like card game made for the 2025 Spengergasse internal game jam",
    links: [{ href: "https://fabbeyond.itch.io/fortuna", label: "itch.io" }],
    image: fortunaImg,
    tags: ["Unity", "C#"],
    isWIP: false,
  },
  {
    title: "Layout Tools",
    description: "Simple tools to make building layouts easier",
    links: [
      {
        href: "https://geode-sdk.org/mods/fabbeyond.layouttools",
        label: "Geode",
      },
      {
        href: "https://github.com/FabBeyond/AutoDisableGlow",
        label: "GitHub",
      },
    ],
    image: layoutToolsImg,
    downloads: "30k+ downloads",
    tags: ["Geometry Dash", "C++"],
    isWIP: false,
  },
  {
    title: "StartPos En/Disabler",
    description: "Enable/Disable multiple start positions with one click",
    links: [
      {
        href: "https://geode-sdk.org/mods/fabbeyond.startposdisabler",
        label: "Geode",
      },
      {
        href: "https://github.com/FabBeyond/StartPosDisabler",
        label: "GitHub",
      },
    ],
    image: startPosImg,
    downloads: "8k+ downloads",
    tags: ["Geometry Dash", "C++"],
    isWIP: false,
  },
  {
    title: "Random Teleport",
    description: "Teleports you somewhere completely random every 3 minutes.",
    links: [
      {
        href: "https://thunderstore.io/c/hollow-knight-silksong/p/fabbeyond/RandomTeleport/",
        label: "Thunderstore",
      },
    ],
    image: randomTeleportImg,
    downloads: "4.5k+ downloads",
    tags: ["Silksong", "C#", "BepInEx"],
    isWIP: false,
  },
  {
    title: "Hornet Addict",
    description:
      "Takes Hornet's needle away and gives her only Flea Brew bottles to throw",
    links: [
      {
        href: "https://thunderstore.io/c/hollow-knight-silksong/p/fabbeyond/HornetAddict/",
        label: "Thunderstore",
      },
    ],
    image: hornetAddictImg,
    downloads: "1.5k+ downloads",
    tags: ["Silksong", "C#", "BepInEx"],
    isWIP: false,
  },
  {
    title: "Infinite Cogflies",
    description: "Mod to remove the Cogfly amount cap",
    links: [
      {
        href: "https://thunderstore.io/c/hollow-knight-silksong/p/fabbeyond/InfiniteCogflies/",
        label: "Thunderstore",
      },
    ],
    image: infiniteCogfliesImg,
    downloads: "10k+ downloads",
    tags: ["Silksong", "C#", "BepInEx"],
    isWIP: false,
  },
  {
    title: "Zaza in Bellhome",
    description:
      "Allows you to bring Zaza to your Bellhome after defeating Lost Garmond",
    links: [
      {
        href: "https://thunderstore.io/c/hollow-knight-silksong/p/fabbeyond/ZaZaInBellhome/",
        label: "Thunderstore",
      },
    ],
    image: zazaImg,
    downloads: "3.5k+ downloads",
    tags: ["Silksong", "C#", "BepInEx"],
    isWIP: false,
  },
  {
    title: "ROMA Bot",
    description: "Discord bot for the Vocaloid producer ROMA",
    links: [
      {
        href: "https://github.com/FabBeyond/romabot",
        label: "GitHub",
      },
      {
        href: "https://discord.gg/YSwMdAyTuj",
        label: "Discord",
      },
    ],
    image: romaImg,
    tags: ["Python", "discord.py", "SQLite"],
    isWIP: false,
  },
  {
    title: "Cogfly",
    description:
      "Silksong mod loader. I contributed settings and misc. bug fixes",
    links: [
      {
        href: "https://github.com/Nix-main/Cogfly",
        label: "GitHub",
      },
    ],
    image: cogflyImg,
    tags: ["Java", "Contribution"],
    isWIP: false,
  },
  {
    title: "Oh, Crab!",
    description:
      "Oh, Crab! is an underwater themed collection game made for the 2026 Spengergasse internal game jam",
    links: [{ href: "https://fabbeyond.itch.io/oh-crab", label: "itch.io" }],
    image: ohCrabImg,
    tags: ["Unity", "C#"],
    isWIP: false,
  },
  {
    title: "Balanced Load",
    description:
      "Balanced Load is a puzzle game about resizing minecraft made for the 2024 GMTK game jam",
    links: [
      { href: "https://fabbeyond.itch.io/balanced-load", label: "itch.io" },
    ],
    image: balancedLoadImg,
    tags: ["Unity", "C#"],
    isWIP: false,
  },
];
const featuredProjects = ["LITT", "TailFE", "Fortuna"];
const games = ["Fortuna", "Oh, Crab!", "Balanced Load"];
const mods = [
  "StartPos En/Disabler",
  "Layout Tools",
  "Random Teleport",
  "Hornet Addict",
  "Infinite Cogflies",
  "Zaza in Bellhome",
];
const programs = ["ROMA Bot", "Cogfly"];
function getProjects(names: string[]) {
  return projects.filter((i) => names.includes(i.title));
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>fabbeyond.dev - Projects</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quantico:wght@400;700&display=swap"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <Navbar />
    <div class="nav-bar-divider"></div>

    <main>
      <div class="about">
        <p class="personal-title font">Hi, I'm Fab.</p>
        <p class="personal-subtitle font">
          I make games, mods, tools and self-hosted backends.
        </p>
        <p class="location font">
          Student at HTL Spengergasse · Vienna, Austria
        </p>
        <div class="skills-list">
          <p>Python</p>
          <p>C#</p>
          <p>JavaScript</p>
          <p>HTML/CSS</p>
          <p>React</p>
          <p>Linux</p>
        </div>

        <div class="about-btn">
          <a
            class="btn-primary font"
            href="https://github.com/FabBeyond/"
            target="_blank"
          >
            GitHub
          </a>
          <a
            class="btn-secondary font"
            href="mailto:fabian.wurmitzer@gmx.at"
            target="_blank"
          >
            Email me
          </a>
        </div>
      </div>

      <p class="collection-title">Featured Projects</p>
      <div class="fav-project-list">
        {getProjects(featuredProjects).map((i) => (
          <ProjectCard {...i} type="fav-project" />
        ))}
      </div>

      <p class="collection-title">Games</p>
      <div class="project-list">
        {getProjects(games).map((i) => (
          <ProjectCard {...i} type="project" />
        ))}
      </div>

      <p class="collection-title">Mods</p>
      <div class="project-list">
        {getProjects(mods).map((i) => (
          <ProjectCard {...i} type="project" />
        ))}
      </div>

      <p class="collection-title">Tools and Contributions</p>
      <div class="project-list">
        {getProjects(programs).map((i) => (
          <ProjectCard {...i} type="project" />
        ))}
      </div>
    </main>
    <div class="nav-bar-divider"></div>

    <Footer />
  </body>
</html>
